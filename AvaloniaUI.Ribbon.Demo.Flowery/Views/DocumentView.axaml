<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaUI.Ribbon.Demo.Flowery.ViewModels"
             xmlns:extensions1="clr-namespace:AvaloniaUI.Ribbon.Demo.Flowery.Extensions"
             xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaUI.Ribbon.Demo.Flowery.Views.DocumentView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    <DockPanel LastChildFill="True">
        <StackPanel
            Margin="25"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="10">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Flowery Theme" />
                <controls:DaisyThemeDropdown
                    Width="180"
                    MinWidth="140"
                    VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel Margin="0,0,20,8" Orientation="Vertical">
                    <Label FontWeight="Bold">Theme</Label>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:DaisyThemeRadio
                            Content="Light"
                            GroupName="FloweryLightDark"
                            ThemeName="{Binding LightRadioThemeName}" />
                        <controls:DaisyThemeRadio
                            Content="Dark"
                            GroupName="FloweryLightDark"
                            ThemeName="{Binding DarkRadioThemeName}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,20,8" Orientation="Vertical">
                    <Label FontWeight="Bold">Ribbon Orientation</Label>
                    <ToggleSwitch
                        x:Name="OrientationToggleSwitch"
                        IsChecked="{Binding SwitchOrientation}"
                        OffContent="Vertical"
                        OnContent="Horizontal" />
                </StackPanel>
                <StackPanel Margin="0,0,20,8" Orientation="Vertical">
                    <Label FontWeight="Bold">Ribbon Group Wrap</Label>
                    <controls:DaisyToggle
                        x:Name="WrapToggleSwitch"
                        IsChecked="{Binding EnableRibbonGroupWrap}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,8" Orientation="Vertical">
                    <Label FontWeight="Bold">Max Wrap Rows</Label>
                    <ComboBox
                        Width="110"
                        IsEnabled="{Binding EnableRibbonGroupWrap}"
                        ItemsSource="{Binding RibbonMaxGroupRowOptions}"
                        SelectedItem="{Binding RibbonMaxGroupRows}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,8" Orientation="Vertical">
                    <Label FontWeight="Bold">Cluster Banks / Row</Label>
                    <ComboBox
                        Width="140"
                        ItemsSource="{Binding ClusterBanksPerRowOptions}"
                        SelectedItem="{Binding ClusterBanksPerRow}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,8" Orientation="Vertical">
                    <Label FontWeight="Bold">File Menu Mode</Label>
                    <ComboBox
                        Width="120"
                        ItemsSource="{Binding RibbonMenuDisplayModeOptions}"
                        SelectedItem="{Binding RibbonMenuDisplayMode}" />
                </StackPanel>
            </WrapPanel>
            <TextBlock
                MaxWidth="640"
                Opacity="0.8"
                Text="Tip: open the 'Wrap Lab' tab and reduce window width. With wrap OFF, groups stay on one clipped row; with wrap ON, they can use up to the selected row count before shrinking."
                TextWrapping="Wrap" />
            <Border
                MaxWidth="760"
                Padding="12"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="RibbonGroupLines" />
                        <TextBlock
                            Opacity="0.9"
                            Text="Best for independent actions. Items are arranged into line slots and can have mixed widths."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Opacity="0.75"
                            Text="See 'Group Containers' tab: Lines Only group."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="RibbonGroupCluster" />
                        <TextBlock
                            Opacity="0.9"
                            Text="Best for dense, compact related actions. Buttons form a tight strip with shared edges."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Opacity="0.75"
                            Text="See 'Group Containers' tab: Lines with Clusters group."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LAST ACTION: " />
                <TextBlock Text="{Binding LastActionText}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="System Decorations Mode : " />
                <ComboBox
                    x:Name="DecorationModeComboBox"
                    Width="200"
                    DisplayMemberBinding="{Binding Value}"
                    ItemsSource="{Binding Source={extensions1:Enumeration {x:Type WindowDecorations}}}"
                    SelectionChanged="OnDecorationModeSelectionChanged"
                    SelectedValue="{Binding WindowDecorations, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RibbonWindow}, Mode=OneWay}"
                    SelectedValueBinding="{Binding Value}" />
            </StackPanel>
            <CheckBox
                Content="Show title bar icon"
                IsChecked="{Binding ShowTitleBarIcon, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RibbonWindow}, Mode=TwoWay}" />
            <CheckBox
                Content="Show File menu"
                IsChecked="{Binding Ribbon.ShowMenu, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RibbonWindow}, Mode=TwoWay}" />
            <CheckBox
                Content="Show Quick Access Toolbar items"
                IsChecked="{Binding QuickAccessToolbar.ShowItems, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RibbonWindow}, Mode=TwoWay}" />
            <CheckBox
                Content="Show Quick Access Toolbar menu button"
                IsChecked="{Binding QuickAccessToolbar.ShowOverflowButton, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RibbonWindow}, Mode=TwoWay}" />
            <!--  CheckBox x:Name="LightsOnCheckBox" Content="Lights" IsChecked="True"/  -->
            <CheckBox Content="Show Contextual tab group 1" IsChecked="{Binding ShowContextualGroup1}" />
            <CheckBox Content="Show Contextual tab group 2" IsChecked="{Binding ShowContextualGroup2}" />
            <CheckBox
                Content="Show Contextual tab group 3, which has a very long name so you can easily see that its only tab's width does not prohibit the group from getting wider as needed"
                IsChecked="{Binding ShowContextualGroup3}" />
            <!--  Button x:Name="TestItemsButton" Content="Test"/  -->
        </StackPanel>
    </DockPanel>
</UserControl>
