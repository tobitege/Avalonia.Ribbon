<Application
    x:Class="AvaloniaUI.Ribbon.W11.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AvaloniaUI.Ribbon/Locale/en-ca.axaml" />
        <ResourceInclude Source="avares://AvaloniaUI.Ribbon/Themes/Accents/Fluent.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <OnPlatform>
      <OnPlatform.Windows>
        <StyleInclude Source="avares://AvaloniaUI.Ribbon.Desktop/Styles/Fluent/AvaloniaRibbon.axaml" />
      </OnPlatform.Windows>
      <OnPlatform.Default>
        <StyleInclude Source="avares://AvaloniaUI.Ribbon/Styles/Fluent/AvaloniaRibbon.axaml" />
      </OnPlatform.Default>
    </OnPlatform>
  </Application.Styles>
</Application>
