<desktop:RibbonWindow
    x:Class="AvaloniaUI.Ribbon.W11.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:desktop="clr-namespace:AvaloniaUI.Ribbon.Desktop;assembly=AvaloniaUI.Ribbon.Desktop"
    xmlns:models="clr-namespace:AvaloniaUI.Ribbon.Models;assembly=AvaloniaUI.Ribbon"
    xmlns:ribbon="clr-namespace:AvaloniaUI.Ribbon;assembly=AvaloniaUI.Ribbon"
    Title="File Explorer"
    Width="1200"
    Height="720"
    MinWidth="1024"
    MinHeight="560"
    Background="#191919"
    BorderBrush="#2B2B2B"
    Icon="avares://AvaloniaUI.Ribbon.W11/Assets/avalonia-logo.ico"
    CanResize="True"
    WindowDecorations="BorderOnly"
    TitleBarForeground="#F2F2F2"
    mc:Ignorable="d">

    <desktop:RibbonWindow.Resources>
        <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
      <ResourceInclude Source="avares://AvaloniaUI.Ribbon/Resources/W11RibbonIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="W11HeaderBg" Color="#0A0A0A" />
      <SolidColorBrush x:Key="W11BodyBg" Color="#1E1E1E" />
      <SolidColorBrush x:Key="W11Accent" Color="#0A64C8" />
    </ResourceDictionary>
  </desktop:RibbonWindow.Resources>

  <desktop:RibbonWindow.Styles>
    <Style Selector="desktop|DesktopRibbon">
      <Setter Property="Background" Value="{DynamicResource W11HeaderBg}" />
      <Setter Property="HeaderBackground" Value="{DynamicResource W11HeaderBg}" />
      <Setter Property="BorderBrush" Value="#2B2B2B" />
      <Setter Property="Foreground" Value="#F2F2F2" />
    </Style>
    <Style Selector="desktop|DesktopRibbon /template/ ContentControl#PART_GroupsPresenterHolder">
      <Setter Property="Background" Value="{DynamicResource W11BodyBg}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="desktop|DesktopRibbon /template/ ItemsControl#PART_SelectedGroupsHost">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Width" Value="{Binding $parent[desktop:DesktopRibbon].Bounds.Width}" />
    </Style>
    <Style Selector="desktop|DesktopRibbon /template/ ToggleButton#ExpandCollapseToggleButton:not(:pointerover):not(:pressed)">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ribbon|RibbonMenu /template/ ToggleButton#ContentButton:not(:pointerover):not(:pressed):not(:checked)">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ribbon|RibbonMenu /template/ ToggleButton#ContentButton:checked">
      <Setter Property="Background" Value="{DynamicResource W11Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource W11Accent}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ribbon|RibbonTab">
      <Setter Property="Foreground" Value="#CECECE" />
      <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style Selector="ribbon|RibbonTab[IsSelected=True]">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ribbon|RibbonGroupBox">
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="Foreground" Value="#999999" />
      <Setter Property="AllowCollapsedPopup" Value="False" />
    </Style>
    <Style Selector="ribbon|RibbonGroupBox.Clipboard /template/ ribbon|RibbonGroupWrapPanel#PART_ItemsPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="SmallLineCount" Value="6" />
      <Setter Property="LargeLineCount" Value="6" />
    </Style>
    <Style Selector="ribbon|RibbonButton, ribbon|RibbonDropDownButton">
      <Setter Property="Foreground" Value="#E0E0E0" />
    </Style>
  </desktop:RibbonWindow.Styles>

  <desktop:RibbonWindow.TitleBarBackground>
    <SolidColorBrush Color="#080808" />
  </desktop:RibbonWindow.TitleBarBackground>

  <desktop:RibbonWindow.QuickAccessToolbar>
    <desktop:QuickAccessToolbar x:Name="WindowQuickAccessToolbar" />
  </desktop:RibbonWindow.QuickAccessToolbar>

  <desktop:RibbonWindow.Ribbon>
    <desktop:DesktopRibbon GroupOverflowBehavior="WrapThenShrink" MaxGroupRows="2">
      <desktop:DesktopRibbon.HelpPaneContent>
        <Button
          Width="22" Height="22" Margin="0,4,4,4"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          Padding="0"
          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
          Background="Transparent" BorderBrush="#5A5A5A" BorderThickness="1" CornerRadius="11"
          Foreground="#D8D8D8">
          <TextBlock
            Text="?"
            FontSize="12"
            FontWeight="SemiBold"
            LineHeight="12"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
        </Button>
      </desktop:DesktopRibbon.HelpPaneContent>

      <desktop:DesktopRibbon.Menu>
        <ribbon:RibbonMenu Content="File" KeyTip.KeyTipKeys="F" Width="78">
          <ribbon:RibbonMenu.RecentDocuments>
            <models:RibbonRecentDocument Title="Notes.txt" Path="C:\Users\Public\Documents\Notes.txt" />
            <models:RibbonRecentDocument Title="Screenshot.png" Path="C:\Users\Public\Pictures\Screenshot.png" />
            <models:RibbonRecentDocument Title="Archive.zip" Path="C:\Users\Public\Documents\Archive.zip" />
          </ribbon:RibbonMenu.RecentDocuments>
          <ribbon:RibbonMenuItem Header="Open PowerShell" IsTopDocked="True">
            <ribbon:RibbonMenuItem.Icon><ContentControl Content="{DynamicResource Open16}" /></ribbon:RibbonMenuItem.Icon>
          </ribbon:RibbonMenuItem>
          <ribbon:RibbonMenuItem Header="Open Settings" IsTopDocked="True">
            <ribbon:RibbonMenuItem.Icon><ContentControl Content="{DynamicResource Properties16}" /></ribbon:RibbonMenuItem.Icon>
          </ribbon:RibbonMenuItem>
          <ribbon:RibbonMenuItem Header="Exit" IsBottomDocked="True">
            <ribbon:RibbonMenuItem.Icon><ContentControl Content="{DynamicResource Delete16}" /></ribbon:RibbonMenuItem.Icon>
          </ribbon:RibbonMenuItem>
        </ribbon:RibbonMenu>
      </desktop:DesktopRibbon.Menu>

      <desktop:DesktopRibbon.Tabs>
        <!-- ═══════════════ HOME TAB ═══════════════ -->
        <ribbon:RibbonTab Header="Home" KeyTip.KeyTipKeys="H">
          <ribbon:RibbonTab.Groups>

            <!-- ── Clipboard ──
                 Pin = Large | Copy, Paste, Cut, Copy path, Paste shortcut on one row -->
            <ribbon:RibbonGroupBox Header="Clipboard" KeyTip.KeyTipKeys="CB" Classes="Clipboard" DisplayMode="Large">
              <ribbon:RibbonGroupLines LargeLineCount="1" SmallLineCount="1" ItemSpacing="2">
                <ribbon:RibbonButton
                  x:Name="PinQuickAccessButton"
                  Content="Pin to Quick&#x0a;access"
                  Icon="{DynamicResource Pin16}"
                  LargeIcon="{DynamicResource Pin32}"
                  MinSize="Large" MaxSize="Large"
                  QuickAccessIcon="{DynamicResource Pin16}" />

                <ribbon:RibbonButton x:Name="CopyButton" Icon="{DynamicResource Copy16}" MinSize="Small" MaxSize="Small" ToolTip.Tip="Copy" />
                <ribbon:RibbonButton Icon="{DynamicResource Paste16}" MinSize="Small" MaxSize="Small" ToolTip.Tip="Paste" />
                <ribbon:RibbonButton Icon="{DynamicResource Cut16}" MinSize="Small" MaxSize="Small" ToolTip.Tip="Cut" />
                <ribbon:RibbonButton Icon="{DynamicResource CopyPath16}" MinSize="Small" MaxSize="Small" ToolTip.Tip="Copy path" />
                <ribbon:RibbonButton Icon="{DynamicResource PasteShortcut16}" MinSize="Small" MaxSize="Small" ToolTip.Tip="Paste shortcut" />
              </ribbon:RibbonGroupLines>
            </ribbon:RibbonGroupBox>

            <!-- ── Organize ──
                 Two columns of 2: (MoveTo/CopyTo) | (Delete/Rename) -->
            <ribbon:RibbonGroupBox Header="Organize" KeyTip.KeyTipKeys="O">
              <ribbon:RibbonGroupTriple MaxItemsPerColumn="2">
                <ribbon:RibbonDropDownButton
                  Content="Move to" Icon="{DynamicResource MoveTo16}"
                  MaxSize="Medium">
                  <ribbon:RibbonDropDownItem Header="Desktop" />
                  <ribbon:RibbonDropDownItem Header="Documents" />
                </ribbon:RibbonDropDownButton>
                <ribbon:RibbonDropDownButton
                  Content="Copy to" Icon="{DynamicResource CopyTo16}"
                  MaxSize="Medium">
                  <ribbon:RibbonDropDownItem Header="Desktop" />
                  <ribbon:RibbonDropDownItem Header="Documents" />
                </ribbon:RibbonDropDownButton>
                <ribbon:RibbonButton Content="Delete" Icon="{DynamicResource Delete16}" MaxSize="Medium" />
                <ribbon:RibbonButton Content="Rename" Icon="{DynamicResource Rename16}" MaxSize="Medium" />
              </ribbon:RibbonGroupTriple>
            </ribbon:RibbonGroupBox>

            <!-- ── New ──
                 NewFolder = Large  |  NewItem + EasyAccess stacked -->
            <ribbon:RibbonGroupBox Header="New" KeyTip.KeyTipKeys="N">
              <ribbon:RibbonButton
                x:Name="NewFolderButton"
                Content="New&#x0a;folder"
                Icon="{DynamicResource NewFolder16}"
                LargeIcon="{DynamicResource NewFolder32}"
                MinSize="Large" MaxSize="Large" />

              <ribbon:RibbonGroupTriple MaxItemsPerColumn="3">
                <ribbon:RibbonDropDownButton
                  Content="New item" Icon="{DynamicResource NewItem16}"
                  MaxSize="Medium">
                  <ribbon:RibbonDropDownItem Header="Folder" />
                  <ribbon:RibbonDropDownItem Header="Text document" />
                  <ribbon:RibbonDropDownItem Header="Bitmap image" />
                </ribbon:RibbonDropDownButton>
                <ribbon:RibbonDropDownButton
                  Content="Easy access" Icon="{DynamicResource EasyAccess16}"
                  MaxSize="Medium">
                  <ribbon:RibbonDropDownItem Header="Include in library" />
                  <ribbon:RibbonDropDownItem Header="Always available offline" />
                </ribbon:RibbonDropDownButton>
              </ribbon:RibbonGroupTriple>
            </ribbon:RibbonGroupBox>

            <!-- ── Open ──
                 Properties = Large  |  Open/Edit/History stacked -->
            <ribbon:RibbonGroupBox Header="Open" KeyTip.KeyTipKeys="P">
              <ribbon:RibbonButton
                Content="Properties"
                Icon="{DynamicResource Properties16}"
                LargeIcon="{DynamicResource Properties32}"
                MinSize="Large" MaxSize="Large" />

              <ribbon:RibbonGroupTriple MaxItemsPerColumn="3">
                <ribbon:RibbonDropDownButton
                  Content="Open" Icon="{DynamicResource Open16}"
                  MaxSize="Medium">
                  <ribbon:RibbonDropDownItem Header="Open in new tab" />
                  <ribbon:RibbonDropDownItem Header="Open in new window" />
                </ribbon:RibbonDropDownButton>
                <ribbon:RibbonButton Content="Edit" Icon="{DynamicResource Edit16}" MaxSize="Medium" />
                <ribbon:RibbonButton Content="History" Icon="{DynamicResource History16}" MaxSize="Medium" />
              </ribbon:RibbonGroupTriple>
            </ribbon:RibbonGroupBox>

            <!-- ── Select ──
                 All 3 items stacked vertically -->
            <ribbon:RibbonGroupBox Header="Select" KeyTip.KeyTipKeys="S">
              <ribbon:RibbonGroupTriple MaxItemsPerColumn="3">
                <ribbon:RibbonButton Content="Select all" Icon="{DynamicResource SelectAll16}" MaxSize="Medium" />
                <ribbon:RibbonButton Content="Select none" Icon="{DynamicResource SelectNone16}" MaxSize="Medium" />
                <ribbon:RibbonButton Content="Invert selection" Icon="{DynamicResource InvertSelection16}" MaxSize="Medium" />
              </ribbon:RibbonGroupTriple>
            </ribbon:RibbonGroupBox>

          </ribbon:RibbonTab.Groups>
        </ribbon:RibbonTab>

        <!-- ═══════════════ NEW CONTROLS TAB ═══════════════ -->
        <ribbon:RibbonTab Header="New Controls" KeyTip.KeyTipKeys="N">
          <ribbon:RibbonTab.Groups>
            <ribbon:RibbonGroupBox Header="Inputs" KeyTip.KeyTipKeys="IN">
              <ribbon:RibbonGroupTriple MaxItemsPerColumn="2">
                <ribbon:RibbonLabel Content="Filter" MaxSize="Medium" />
                <ribbon:RibbonTextBox Text="*.cs" MaxSize="Medium" />
                <ribbon:RibbonNumericUpDown Value="7" MaxSize="Medium" />
              </ribbon:RibbonGroupTriple>
            </ribbon:RibbonGroupBox>
            <ribbon:RibbonGroupBox Header="Date" KeyTip.KeyTipKeys="DT">
              <ribbon:RibbonGroupTriple MaxItemsPerColumn="1">
                <ribbon:RibbonDatePicker SelectedDate="2026-02-13" MonthFormat="MMMM" MaxSize="Medium" />
              </ribbon:RibbonGroupTriple>
            </ribbon:RibbonGroupBox>
            <ribbon:RibbonGroupBox Header="View options" KeyTip.KeyTipKeys="VO">
              <ribbon:RibbonGroupTriple MaxItemsPerColumn="2">
                <ribbon:RibbonCheckBox Content="Hidden" MaxSize="Medium" />
                <ribbon:RibbonRadioButton Content="Details" GroupName="ViewMode" IsChecked="True" MaxSize="Medium" />
                <ribbon:RibbonRadioButton Content="Tiles" GroupName="ViewMode" MaxSize="Medium" />
                <ribbon:RibbonSeparator MaxSize="Medium" />
              </ribbon:RibbonGroupTriple>
            </ribbon:RibbonGroupBox>
          </ribbon:RibbonTab.Groups>
        </ribbon:RibbonTab>

        <!-- ═══════════════ SHARE TAB ═══════════════ -->
        <ribbon:RibbonTab Header="Share" KeyTip.KeyTipKeys="R">
          <ribbon:RibbonTab.Groups>
            <ribbon:RibbonGroupBox Header="Share">
              <ribbon:RibbonButton Content="Share" Icon="{DynamicResource Share16}" MaxSize="Medium" />
            </ribbon:RibbonGroupBox>
          </ribbon:RibbonTab.Groups>
        </ribbon:RibbonTab>

        <!-- ═══════════════ VIEW TAB ═══════════════ -->
        <ribbon:RibbonTab Header="View" KeyTip.KeyTipKeys="V">
          <ribbon:RibbonTab.Groups>
            <ribbon:RibbonGroupBox Header="View">
              <ribbon:RibbonButton Content="Layout" Icon="{DynamicResource View16}" MaxSize="Medium" />
            </ribbon:RibbonGroupBox>
          </ribbon:RibbonTab.Groups>
        </ribbon:RibbonTab>
      </desktop:DesktopRibbon.Tabs>
    </desktop:DesktopRibbon>
  </desktop:RibbonWindow.Ribbon>

  <Border Background="#171717" />
</desktop:RibbonWindow>
