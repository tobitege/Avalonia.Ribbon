<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFrameworks>netstandard2.0</TargetFrameworks>
		<RootNamespace>AvaloniaUI.Ribbon</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Version>0.9.9</Version>
		<Authors>Splitwirez, Alban Mazerolles, Rubal Walia, Sachith Liyanagama</Authors>
		<PackageId>AvaloniaControls.Ribbon</PackageId>
		<PackageProjectUrl>https://github.com/SachiHarshitha/Avalonia.Ribbon</PackageProjectUrl>
		<Description>Office-Like ribbon control for Avalonia framework, for cross-platform projects such as WASM and Desktop.</Description>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>https://github.com/SachiHarshitha/Avalonia.Ribbon.git</RepositoryUrl>
		<AssemblyName>AvaloniaUI.Ribbon</AssemblyName>
		<LangVersion>latest</LangVersion>
		<PackageTags>ribbon;avalonia;avaloniaui;avalonia ui;ribbon;ribbonui;ribbon ui;crossplat;crossplatform;cross platform;xplat;xplatform;wasm</PackageTags>
		<Title>Cross-Platform Ribbon control for Avalonia</Title>
		<Copyright>Partial Copyright (c) 2023 Sachith Liyanagama</Copyright>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!--owners? requireLicenseAcceptance? releaseNotes? copyright?-->
	</PropertyGroup>
	<ItemGroup>
		<Compile Update="**\*.axaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
		</Compile>
		<AvaloniaResource Include="**\*.axaml">
			<SubType>Designer</SubType>
		</AvaloniaResource>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>
	<ItemGroup>
		<AvaloniaResource Remove="Controls\GalleryItem.axaml" />
		<AvaloniaResource Remove="Controls\InRibbonGallery.axaml" />
		<AvaloniaResource Remove="Controls\RibbonButton.axaml" />
		<AvaloniaResource Remove="Controls\RibbonGallery.axaml" />
		<AvaloniaResource Remove="Controls\SplitButtonControl.axaml" />
		<AvaloniaResource Remove="RibbonControl.axaml" />
		<AvaloniaResource Remove="Themes\Accents\Fluent.axaml" />
		<AvaloniaResource Remove="Themes\Accents\Simple.axaml" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.2.5" />
		<PackageReference Include="Avalonia.ReactiveUI" Version="11.2.5" />
		<PackageReference Include="Avalonia.Xaml.Interactions" Version="11.2.0.14" />
	</ItemGroup>
	<ItemGroup>
		<AvaloniaXaml Update="Styles\Fluent\Controls\SplitButtonControl.axaml">
			<Generator>MSBuild:Compile</Generator>
		</AvaloniaXaml>
		<AvaloniaXaml Update="Styles\Material\Controls\SplitButtonControl.axaml">
		  <Generator>MSBuild:Compile</Generator>
		</AvaloniaXaml>
	</ItemGroup>
</Project>