  <!-- View — grid layout -->
  <StreamGeometry x:Key="ViewGeo">M3,5 L3,9 L9,9 L9,5z M3,13 L3,17 L9,17 L9,13z M11,5 L11,9 L17,9 L17,5z M11,13 L11,17 L17,17 L17,13z M19,5 L19,9 L21,9 L21,5z M19,13 L19,17 L21,17 L21,13z</StreamGeometry>

  <!-- ═══════════ ICON VIEWBOXES ═══════════ -->
  <!-- Helper macro: Canvas 24x24 → Viewbox scaled to target size -->
  <!-- 16px -->
  <Viewbox x:Key="Pin16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource PinGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Copy16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource CopyGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Paste16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource PasteGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Cut16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource CutGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="CopyPath16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource CopyPathGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="PasteShortcut16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource PasteShortcutGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="MoveTo16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource MoveToGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="CopyTo16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource CopyToGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Delete16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource DeleteGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Rename16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource RenameGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="NewFolder16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource NewFolderGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="NewItem16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource NewItemGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="EasyAccess16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource EasyAccessGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Properties16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource PropertiesGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Open16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource OpenGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Edit16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource EditGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="History16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource HistoryGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="SelectAll16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource SelectAllGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="SelectNone16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource SelectNoneGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="InvertSelection16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource InvertSelectionGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Share16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource ShareGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="View16" x:Shared="False" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource ViewGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>

  <!-- 32px large icons -->
  <Viewbox x:Key="Pin32" x:Shared="False" Width="32" Height="32"><Canvas Width="24" Height="24"><Path Data="{StaticResource PinGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="NewFolder32" x:Shared="False" Width="32" Height="32"><Canvas Width="24" Height="24"><Path Data="{StaticResource NewFolderGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
  <Viewbox x:Key="Properties32" x:Shared="False" Width="32" Height="32"><Canvas Width="24" Height="24"><Path Data="{StaticResource PropertiesGeo}" Fill="{DynamicResource W11Fg}"/></Canvas></Viewbox>
</ResourceDictionary>
