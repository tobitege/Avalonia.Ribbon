<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="W11Fg" Color="#E8E8E8" />

  <!-- ═══════════ ICON GEOMETRY (24×24 viewBox) ═══════════ -->

  <!-- Pin / Thumbtack — proper pushpin: round head, angled shaft, point at bottom -->
