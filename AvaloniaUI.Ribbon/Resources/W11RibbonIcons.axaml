  <StreamGeometry x:Key="PropertiesGeo">M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2z M13,17 L11,17 L11,11 L13,11z M13,9 L11,9 L11,7 L13,7z</StreamGeometry>

