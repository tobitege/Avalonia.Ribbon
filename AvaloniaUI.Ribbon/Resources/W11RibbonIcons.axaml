  <!-- Edit -->
  <StreamGeometry x:Key="EditGeo">M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87z</StreamGeometry>

