<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AvaloniaUI.Ribbon;assembly=AvaloniaUI.Ribbon">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AvaloniaUI.Ribbon/SizeResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ControlTheme x:Key="{x:Type local:RibbonTextBox}" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="local:RibbonTextBox" />
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="local|RibbonTextBox">
        <Setter Property="Height" Value="{StaticResource MediumControlHeight}" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="local|RibbonTextBox[Size=Large]">
        <Setter Property="Width" Value="180" />
    </Style>
    <Style Selector="local|RibbonTextBox[Size=Medium]">
        <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector="local|RibbonTextBox[Size=Small]">
        <Setter Property="Height" Value="{StaticResource SmallControlHeight}" />
        <Setter Property="Width" Value="104" />
    </Style>
</Styles>
