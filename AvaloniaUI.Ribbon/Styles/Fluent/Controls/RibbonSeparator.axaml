<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AvaloniaUI.Ribbon;assembly=AvaloniaUI.Ribbon">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AvaloniaUI.Ribbon/SizeResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ControlTheme x:Key="{x:Type local:RibbonSeparator}" BasedOn="{StaticResource {x:Type Separator}}" TargetType="local:RibbonSeparator" />
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="local|RibbonSeparator">
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Background" Value="{DynamicResource ThemeBorderLowBrush}" />
        <Setter Property="Width" Value="1" />
    </Style>
    <Style Selector="local|RibbonSeparator[Size=Large]">
        <Setter Property="Height" Value="{StaticResource LargeControlHeight}" />
    </Style>
    <Style Selector="local|RibbonSeparator[Size=Medium]">
        <Setter Property="Height" Value="{StaticResource MediumControlHeight}" />
    </Style>
    <Style Selector="local|RibbonSeparator[Size=Small]">
        <Setter Property="Height" Value="{StaticResource SmallControlHeight}" />
    </Style>
</Styles>
