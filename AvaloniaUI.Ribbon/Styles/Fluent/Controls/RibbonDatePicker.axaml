<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AvaloniaUI.Ribbon;assembly=AvaloniaUI.Ribbon">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AvaloniaUI.Ribbon/SizeResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ControlTheme x:Key="{x:Type local:RibbonDatePicker}" BasedOn="{StaticResource {x:Type DatePicker}}" TargetType="local:RibbonDatePicker" />
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="local|RibbonDatePicker">
        <Setter Property="Height" Value="{StaticResource MediumControlHeight}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="local|RibbonDatePicker[Size=Large]">
    </Style>
    <Style Selector="local|RibbonDatePicker[Size=Medium]">
    </Style>
    <Style Selector="local|RibbonDatePicker[Size=Small]">
        <Setter Property="Height" Value="{StaticResource SmallControlHeight}" />
    </Style>
</Styles>
